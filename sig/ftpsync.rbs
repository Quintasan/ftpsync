# Types for FtpSync.
#
# `FtpSync::VERSION` and `FtpSync::Simple` are the whole public surface:
# everything under `Simple::Session`, `Simple::Entry`, `Simple::Listing`,
# `Simple::Pull`, `Simple::Push` and `Simple::Prune` is internal. Those collaborators are still declared here, because they are
# private methods and modules of `Simple` and Steep can only check
# `lib/ftpsync.rb` as one unit if it knows their types.
#
# The call surface is the Ruby 2.6 one -- positional option hashes, no keyword
# arguments -- so these signatures describe what callers can pass on every Ruby
# the gem supports.

module FtpSync
  VERSION: String

  # The option hash accepted by `Simple#initialize` and by `Simple#pull_dir` /
  # `Simple#push_dir`.
  #
  # Values are `untyped` on purpose. The library validates *keys* at runtime
  # (`Simple#validate_options`) and lets the values through to `Net::FTP` or
  # into comparisons, so pinning them here would reject option hashes that work
  # today. `nil` is accepted in place of a hash and means "no options"; both
  # are spelled out at each call site below.
  type options = Hash[Symbol, untyped]
end

class FtpSync::Simple
  # Suffix of the side file a transfer is written to before it is renamed into
  # place.
  PART_SUFFIX: String

  # Connection timeouts in seconds, used when the corresponding constructor
  # option is absent.
  DEFAULT_OPEN_TIMEOUT: Integer
  DEFAULT_READ_TIMEOUT: Integer

  # How far a local file may lead the remote timestamp and still count as
  # unchanged. `LIST` reports whole minutes, so it needs a wide tolerance;
  # `MLSD` and `MDTM` report whole seconds in UTC, so they need almost none.
  DEFAULT_MTIME_TOLERANCE: Integer
  MDTM_TOLERANCE: Integer

  # Option keys each entry point accepts. They are exposed constants, so a
  # caller can build its option hash without duplicating them. `PULL_OPTIONS`
  # also carries :protect_local, which has no meaning while pushing; :prune is
  # accepted by both directions.
  CONSTRUCTOR_OPTIONS: Array[Symbol]
  PULL_OPTIONS: Array[Symbol]
  PUSH_OPTIONS: Array[Symbol]

  # Internal: the MDTM time-val format, and the reply codes that mean "this
  # server has no MDTM/MLSD/RNTO", as opposed to a per-file failure.
  MDTM_FORMAT: Regexp
  MDTM_UNSUPPORTED: Regexp
  RENAME_UNSUPPORTED: Regexp
  MLSD_UNSUPPORTED: Regexp

  # Reported for a listing entry whose type could not be determined.
  UNUSABLE_ENTRY: String

  # Read when a connection is opened. Assigning to them later does not move an
  # open connection and does not relabel it in the log.
  attr_accessor server: String
  attr_accessor port: Integer
  attr_accessor username: String
  attr_accessor password: String
  attr_accessor passive: bool

  # Creates a client for +server+.
  #
  # Constructor options:
  #   :port             Integer port, default 21
  #   :passive          bool, default true; active mode cannot traverse NAT
  #   :verbose          log connection and transfer progress to stderr
  #   :implicit_ftps    connect over implicit FTPS; implies :ssl
  #   :ssl              upgrade the connection with AUTH TLS
  #   :open_timeout     seconds allowed for opening the control connection
  #   :read_timeout     seconds allowed for a single read
  #   :mtime_tolerance  seconds of tolerance for LIST-based comparisons
  #   :atomic_uploads   upload to a side file and rename it into place
  #
  # Unknown keys raise ArgumentError, and so does a non-Hash that is not nil.
  # No connection is opened until it is needed.
  def initialize: (
    String server,
    String username,
    String password,
    ?(FtpSync::options | nil) options
  ) -> void

  # Recursively pulls +remotepath+ into +localpath+ and returns the tally.
  #
  # Pull options:
  #   :since          skip files whose local copy is current
  #   :skip_errors    rescue Net::FTPError, log it and keep going
  #   :protect_local  skip files that are newer locally than on the server
  #   :prune          delete local entries the remote listing does not have
  #
  # The block receives the local path of every file that was fully downloaded;
  # skipped and failed files never reach it. The connection is opened here if it
  # is not already open and closed again when the outermost sync finishes.
  def pull_dir: (
    String remotepath,
    String localpath,
    ?(FtpSync::options | nil) options
  ) ?{ (String local_file) -> void } -> Result

  # Recursively pushes +localpath+ into +remotepath+, creating the remote
  # directories that are missing, and returns the tally.
  #
  # Push options:
  #   :since          skip files whose remote copy is current
  #   :skip_errors    rescue Net::FTPError, log it and keep going
  #   :prune          delete remote entries the local tree does not have
  #
  # The block receives the remote path of every file that was fully uploaded.
  # +localpath+ that is not a directory raises ArgumentError before a
  # connection is opened.
  def push_dir: (
    String localpath,
    String remotepath,
    ?(FtpSync::options | nil) options
  ) ?{ (String remote_file) -> void } -> Result

  # Opens the connection, closing any connection that is already open. Called
  # for you by the sync methods; opening it yourself only moves a connection or
  # login failure earlier. It cannot keep a connection alive across syncs: every
  # top-level sync closes it at depth zero, and `#close!` closes it explicitly.
  # Returns nothing: the connection stays private.
  def connect!: () -> nil

  # Closes the connection if one is open. Idempotent, and safe on a client that
  # never connected.
  def close!: () -> nil

  # Writes +message+ to stderr when the instance was created with :verbose, and
  # does nothing otherwise.
  def log: (String message) -> nil

  # Outcome of one top-level sync.
  #
  # +transferred+ counts files that reached their destination, +skipped+ counts
  # entries deliberately left alone, +deleted+ counts entries pruned under
  # :prune, and +failed+ counts the errors that :skip_errors swallowed together
  # with listing entries that could not be interpreted, each of which is also
  # listed in +errors+ as a [path, message] pair.
  class Result
    attr_accessor transferred: Integer
    attr_accessor skipped: Integer
    attr_accessor failed: Integer
    attr_accessor errors: Array[[String, String]]
    attr_accessor deleted: Integer

    def initialize: (
      Integer transferred,
      Integer skipped,
      Integer failed,
      Array[[String, String]] errors,
      Integer deleted
    ) -> void
  end

  # One listing entry, normalised from an MLSx fact set or a parsed LIST line.
  # +type+ is nil when the source did not say what the entry is; +mtime+ is nil
  # when it carried no usable modification time, and +mtime_source+ (:mlsx or
  # :list) records the precision the timestamp has.
  class Entry
    MLSX_TYPES: Hash[String, Symbol]
    PSEUDO_NAMES: Array[String]

    def self.from_mlsx: (Net::FTP::MLSxEntry mlsx_entry) -> Entry?
    def self.from_list: (Net::FTP::List::Entry list_entry) -> Entry

    attr_reader basename: String
    attr_reader type: Symbol?
    attr_reader filesize: Integer
    attr_reader mtime: Time?
    attr_reader mtime_source: Symbol

    def initialize: (
      String basename,
      Symbol? type,
      Integer filesize,
      Time? mtime,
      Symbol mtime_source
    ) -> void

    def dir?: () -> bool
    def file?: () -> bool
    def pseudo?: () -> bool
  end

  # What one directory listing turned into: subdirectories to recurse into,
  # files to transfer, every name the source reports (the keep-set for pruning)
  # and how completely the listing could be interpreted.
  class Listing
    attr_accessor directories: Array[[String, String]]
    attr_accessor files: Array[[String, String, Entry]]
    attr_accessor names: Hash[String, bool]
    attr_accessor status: Symbol

    def initialize: (
      Array[[String, String]] directories,
      Array[[String, String, Entry]] files,
      Hash[String, bool] names,
      Symbol status
    ) -> void
  end

  # State of one top-level sync: the caller's options, the tally that becomes
  # the return value, and the remote directories this sync already created or
  # confirmed.
  class Session
    attr_reader options: FtpSync::options
    attr_reader result: Result

    def initialize: (FtpSync::options options) -> void
    def known_directory?: (String path) -> bool
    def remember_directory: (String path) -> void

    @options: FtpSync::options
    @result: Result
    @known_directories: Hash[String, bool]
  end

  include FtpSync::Simple::Pull
  include FtpSync::Simple::Push

  # Connection lifecycle is not thread-safe: one instance owns one connection
  # and the sync in progress, so use one instance per thread.
  @server: String
  @username: String
  @password: String
  @port: Integer
  @passive: bool
  @verbose: bool
  @ssl: bool
  @implicit_ftps: bool
  @open_timeout: Integer
  @read_timeout: Integer
  @mtime_tolerance: Numeric
  @atomic_uploads: bool

  # Declared non-nil even though `#close!` and the state before the first
  # `#connect!` leave it nil: every read happens in or below `#synchronize`,
  # which connects first, and Steep cannot describe "nil only while no sync is
  # running". The two nil resets are therefore reported as hints, not errors.
  @connection: Net::FTP
  @endpoint: String?
  @depth: Integer
  @mdtm_supported: bool
  @rename_supported: bool
  @mlsx_supported: bool

  private

  def apply_options: (FtpSync::options options) -> void
  def validate_options: (FtpSync::options options, Array[Symbol] allowed, String context) -> void
  # `options` is required rather than optional: both callers pass it, and it may
  # be nil, which the method normalises to an empty hash.
  def sync_options: (FtpSync::options? options, Array[Symbol] allowed) -> FtpSync::options
  # An empty remote path is the login directory; a local path must be non-empty.
  def validate_remote_path: (untyped path) -> void
  def validate_local_path: (untyped path) -> void

  # Rejects a tolerance that is not a non-negative number, at construction time.
  def validate_mtime_tolerance: (untyped value) -> void

  # Runs a top-level sync on a live connection and closes it afterwards. Only
  # the outermost call closes, so a callback can start another sync.
  def synchronize: () { () -> void } -> void

  def reset_capabilities: () -> void
  def connection_options: () -> Hash[Symbol, untyped]

  def skip_entry: (String path, String reason, Session session) -> void
  def join_remote: (String? remote_dir, String basename) -> String
  def remote_components: (String remotepath) -> Array[String]

  # Returns :ok, :partial (some entries could not be interpreted) or :failed.
  def each_entry: (String remotepath, Session session) { (Entry entry) -> void } -> Symbol

  # Yields the raw listing from MLSD when the server has it, from LIST otherwise.
  def listing_entries: (String remotepath) { (Entry entry) -> void } -> void

  # A nil status means no listing was asked for.
  def remote_entries: (String remotepath, Session session) -> [Symbol?, Hash[String, Entry]]

  # The parsed entries for a path, or nil when the server will not list it.
  def entries_at: (String path) -> Array[Entry]?

  # The entry for a path in its parent directory, or nil when the parent cannot
  # be listed or does not report the name.
  def parent_entry: (String path) -> Entry?

  def skip_upload?: (
    String remote_file,
    Entry? remote_entry,
    String local_path,
    Session session
  ) -> bool

  # A LIST timestamp is a wall clock reading and needs the wide default
  # tolerance; MLSD and MDTM date entries in UTC with second precision.
  def tolerance_for: (Symbol provenance) -> Numeric
  def remote_time: (String remote_file, Entry entry) -> [Time?, Symbol]
  def entry_time: (Entry entry) -> [Time?, Symbol]
  def note_mdtm_failure: (String remote_file, Net::FTPError error) -> void

  # The shared transfer guard: `true` when the transfer completed, `false` when
  # :skip_errors swallowed its failure.
  def transfer_file: (String path, Session session) { () -> void } -> bool
  def report_error: (Result result, String path, Net::FTPError error) -> void
  def report_failure: (Result result, String path, String message) -> void
end

# The pull direction: listing a remote tree and turning it into local files.
module FtpSync::Simple::Pull
  @connection: Net::FTP
  @mtime_tolerance: Numeric
  @mdtm_supported: bool

  private

  # Provided by `FtpSync::Simple`, which includes this module. Steep types the
  # `self` of a module method as the module itself, so the helpers it calls are
  # redeclared here with the same types as in the class.
  def log: (String message) -> nil
  def join_remote: (String? remote_dir, String basename) -> String
  def each_entry: (
    String remotepath,
    FtpSync::Simple::Session session
  ) { (FtpSync::Simple::Entry entry) -> void } -> Symbol
  def skip_entry: (String path, String reason, FtpSync::Simple::Session session) -> void
  def transfer_file: (String path, FtpSync::Simple::Session session) { () -> void } -> bool
  # Provided by `FtpSync::Simple::Prune`.
  def prune_local_directory: (
    String localpath,
    Hash[String, bool] remote_names,
    Symbol status,
    FtpSync::Simple::Session session
  ) -> void

  def pull_into: (
    String remotepath,
    String localpath,
    FtpSync::Simple::Session session
  ) ?{ (String local_file) -> void } -> void

  def ensure_local_directory: (String localpath) -> void

  # Nil when the listing itself failed and was swallowed.
  def scan_directory: (
    String remotepath,
    String localpath,
    FtpSync::Simple::Session session
  ) -> FtpSync::Simple::Listing?

  def scan_entry: (
    FtpSync::Simple::Listing listing,
    String remotepath,
    String localpath,
    FtpSync::Simple::Entry entry,
    FtpSync::Simple::Session session
  ) -> void

  def entry_type: (FtpSync::Simple::Entry entry) -> String
  def pull_file?: (
    String local_path,
    FtpSync::Simple::Entry entry,
    FtpSync::Simple::Session session
  ) -> bool
  def keep_local_without_remote_time?: (String local_path, FtpSync::Simple::Session session) -> bool
  def skip_file?: (
    String local_path,
    FtpSync::Simple::Entry entry,
    FtpSync::Simple::Session session
  ) -> bool
  def newer_local?: (String local_path, FtpSync::Simple::Entry entry) -> bool

  def download: (
    String remote_file,
    String local_file,
    FtpSync::Simple::Entry entry,
    FtpSync::Simple::Session session
  ) ?{ (String local_file) -> void } -> void

  def warn_size_mismatch: (String remote_file, String partial, FtpSync::Simple::Entry entry) -> void
end

# The push direction: creating the remote tree and storing files in it.
module FtpSync::Simple::Push
  @connection: Net::FTP
  @atomic_uploads: bool
  @rename_supported: bool

  private

  # Provided by `FtpSync::Simple`, which includes this module; see the note in
  # `FtpSync::Simple::Pull`.
  def log: (String message) -> nil
  def join_remote: (String? remote_dir, String basename) -> String
  # A nil status means no listing was asked for.
  def remote_entries: (
    String remotepath,
    FtpSync::Simple::Session session
  ) -> [Symbol?, Hash[String, FtpSync::Simple::Entry]]
  def entries_at: (String path) -> Array[FtpSync::Simple::Entry]?
  def parent_entry: (String path) -> FtpSync::Simple::Entry?
  def remote_components: (String remotepath) -> Array[String]
  def skip_entry: (String path, String reason, FtpSync::Simple::Session session) -> void
  def skip_upload?: (
    String remote_file,
    FtpSync::Simple::Entry? remote_entry,
    String local_path,
    FtpSync::Simple::Session session
  ) -> bool
  def transfer_file: (String path, FtpSync::Simple::Session session) { () -> void } -> bool
  def report_error: (
    FtpSync::Simple::Result result,
    String path,
    Net::FTPError error
  ) -> void
  # Provided by `FtpSync::Simple::Prune`.
  def prune_remote_directory: (
    String remotepath,
    Hash[String, FtpSync::Simple::Entry] remote_entries,
    Hash[String, bool] local_names,
    Symbol? status,
    FtpSync::Simple::Session session
  ) -> void

  def push_into: (
    String localpath,
    String remotepath,
    FtpSync::Simple::Session session
  ) ?{ (String remote_file) -> void } -> void

  def push_entry: (
    String local_child,
    String remote_child,
    FtpSync::Simple::Entry? remote_entry,
    FtpSync::Simple::Session session
  ) ?{ (String remote_file) -> void } -> void

  def ensure_remote_directory: (String remotepath, FtpSync::Simple::Session session) -> void
  def create_remote_directory: (String path, FtpSync::Simple::Session session) -> void

  def explain_failed_mkdir: (
    String path,
    FtpSync::Simple::Session session,
    Net::FTPError error
  ) -> void
  def remote_directory?: (String path) -> bool

  def upload: (
    String local_file,
    String remote_file,
    FtpSync::Simple::Entry? remote_entry,
    FtpSync::Simple::Session session
  ) ?{ (String remote_file) -> void } -> void

  def store_file: (String local_file, String remote_file) -> void
  def store_side_file: (String local_file, String temporary) -> void
  def rename_side_file: (String temporary, String remote_file) -> Net::FTPError?
  def store_without_rename: (String local_file, String remote_file, Net::FTPError error) -> void
  def store_in_place: (String local_file, String remote_file) -> void
  def discard_remote_file: (String path) -> void
end

# :prune deletes what the source no longer has, in both directions. It only
# deletes from a listing that was read and interpreted whole.
module FtpSync::Simple::Prune
  private

  # Provided by `FtpSync::Simple`, which includes this module; see the note in
  # `FtpSync::Simple::Pull`.
  def log: (String message) -> nil
  def join_remote: (String? remote_dir, String basename) -> String
  def each_entry: (
    String remotepath,
    FtpSync::Simple::Session session
  ) { (FtpSync::Simple::Entry entry) -> void } -> Symbol
  def entry_type: (FtpSync::Simple::Entry entry) -> String
  def report_error: (
    FtpSync::Simple::Result result,
    String path,
    Net::FTPError error
  ) -> void

  def prune_local_directory: (
    String localpath,
    Hash[String, bool] remote_names,
    Symbol status,
    FtpSync::Simple::Session session
  ) -> void
  def remove_local_entry: (String local_path, FtpSync::Simple::Session session) -> void
  def remove_local_tree: (String local_path, FtpSync::Simple::Session session) -> void

  def prune_remote_directory: (
    String remotepath,
    Hash[String, FtpSync::Simple::Entry] remote_entries,
    Hash[String, bool] local_names,
    Symbol? status,
    FtpSync::Simple::Session session
  ) -> void
  # `true` when the entry is gone; nil when it was left in place.
  def remove_remote_entry: (
    String remote_path,
    FtpSync::Simple::Entry entry,
    FtpSync::Simple::Session session
  ) -> true?
  def remove_remote_content: (
    String remote_path,
    FtpSync::Simple::Entry entry,
    FtpSync::Simple::Session session
  ) -> true?
  def remove_remote_tree: (String remote_path, FtpSync::Simple::Session session) -> true?
  def deleted_entry: (String path, FtpSync::Simple::Session session) -> void
  def refuse_pruning: (String path, Symbol? status) -> nil
end

# Members of `net-ftp` 0.3.9 that this library calls but that
# `sig/external/net-ftp.rbs` (outside this change's scope) does not declare yet.
# Move these next to the other net-ftp stubs and delete this block.
class Net::FTP
  # One MLSx entry: the fact set and the path it describes.
  class MLSxEntry
    attr_reader facts: Hash[String, untyped]
    attr_reader pathname: String

    def initialize: (Hash[String, untyped] facts, String pathname) -> void
  end

  def mlsd: (?String? pathname) ?{ (MLSxEntry entry) -> void } -> Array[MLSxEntry]
  def rmdir: (String dirname) -> void
end
